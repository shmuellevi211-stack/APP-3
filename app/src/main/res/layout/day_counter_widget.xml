<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="5dp"
    android:background="@drawable/widget_background">
    <ImageView
        android:id="@+id/widget_temple_image"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_launcher"
        android:contentDescription="בית המקדש"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="714,498"
        android:textColor="#FFFFC94D"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ימים בלי בית מקדש"
        android:textColor="#FFFFF4D8"
        android:textSize="10sp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="אם אשכחך ירושלים תשכח ימיני"
        android:textColor="#FFFFF4D8"
        android:textSize="9sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
