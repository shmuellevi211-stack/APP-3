<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="3dp"
    android:background="@drawable/widget_background">
    <ImageView
        android:id="@+id/widget_temple_image"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:contentDescription="בית המקדש"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_temple_scene" />
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="714,498"
        android:textColor="#FF08284D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ימים בלי בית מקדש"
        android:textColor="#FF08284D"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false" />
    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:background="#FFD5A53B" />
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="אם אשכחך ירושלים תשכח ימיני"
        android:textColor="#FF08284D"
        android:textSize="8sp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
